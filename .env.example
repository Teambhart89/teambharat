# SaltStayz configuration — copy to .env or set on your host

# Port the server listens on (Render/Railway set this automatically)
PORT=3000

# Public URL of the deployed site (used in feedback links inside emails)
BASE_URL=http://localhost:3000

# Admin panel password
ADMIN_PASSWORD=saltstayz123

# SMTP — leave unset to run in demo mode (emails saved to ./outbox)
# Gmail example (create an App Password at https://myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=SaltStayz <yourname@gmail.com>
