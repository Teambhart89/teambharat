{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "780px",
			"wideSize": "1220px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "ink", "color": "#16211b", "name": "Ink" },
				{ "slug": "body", "color": "#40514a", "name": "Body text" },
				{ "slug": "muted", "color": "#6c7d75", "name": "Muted" },
				{ "slug": "green-900", "color": "#12291b", "name": "Deep forest" },
				{ "slug": "green-700", "color": "#1f5136", "name": "Forest" },
				{ "slug": "green-500", "color": "#2f8055", "name": "Leaf" },
				{ "slug": "green-200", "color": "#a9d7bb", "name": "Soft leaf" },
				{ "slug": "green-50", "color": "#f0f7f2", "name": "Mint tint" },
				{ "slug": "clay-500", "color": "#c4714c", "name": "Terracotta" },
				{ "slug": "clay-100", "color": "#f7e6dd", "name": "Clay tint" },
				{ "slug": "sand", "color": "#faf7f1", "name": "Sand" },
				{ "slug": "white", "color": "#ffffff", "name": "White" }
			],
			"gradients": [
				{
					"slug": "forest",
					"name": "Forest",
					"gradient": "linear-gradient(135deg, #17381f 0%, #276643 100%)"
				},
				{
					"slug": "leaf-tint",
					"name": "Leaf tint",
					"gradient": "linear-gradient(180deg, #faf7f1 0%, #ffffff 100%)"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Small" },
				{ "slug": "medium", "size": "1.05rem", "name": "Medium" },
				{ "slug": "large", "size": "1.4rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.85rem", "name": "Extra large" },
				{ "slug": "xx-large", "size": "2.45rem", "name": "Display" }
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"lineHeight": "1.68"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--green-700)" }
			},
			"h1": { "color": { "text": "var(--wp--preset--color--ink)" } },
			"h2": { "color": { "text": "var(--wp--preset--color--ink)" } },
			"h3": { "color": { "text": "var(--wp--preset--color--ink)" } },
			"h4": { "color": { "text": "var(--wp--preset--color--ink)" } }
		}
	}
}
